{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/authority.schema.json",
  "title": "ETTP Authority",
  "description": "A bounded grant of authority that explains why an action is allowed.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "action": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString"
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString" },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "scope": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString"
    },
    "grantor": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "grantee": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "issued_at": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Timestamp"
    },
    "expires_at": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Timestamp"
    },
    "metadata": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Metadata"
    }
  },
  "required": ["id", "capabilities", "constraints"],
  "additionalProperties": false
}
