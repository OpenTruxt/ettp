{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/evidence-checkpoint.schema.json",
  "title": "ETTP Evidence Chain Checkpoint",
  "description": "A detached commitment to a specific evidence-chain sequence length and tail.",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "tail_event_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "tail_event_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "checkpoint_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "required": ["sequence", "tail_event_id", "tail_event_hash", "checkpoint_hash"],
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 0}}},
      "then": {
        "properties": {
          "tail_event_id": {"type": "null"},
          "tail_event_hash": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "tail_event_id": {"type": "string", "minLength": 1},
          "tail_event_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
