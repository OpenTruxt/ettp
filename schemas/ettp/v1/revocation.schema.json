{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/revocation.schema.json",
  "title": "ETTP Revocation",
  "description": "A typed revocation record for delegation, authority, or entity state.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "target_type": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString"
    },
    "target_id": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "action": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString"
    },
    "reason": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/NonEmptyString"
    },
    "actor": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Identifier"
    },
    "issued_at": {
      "$ref": "https://github.com/OpenTruxt/ettp/schemas/ettp/v1/common.schema.json#/$defs/Timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "REVOKED"]
    }
  },
  "required": ["id", "target_type", "target_id", "action"],
  "additionalProperties": false
}
